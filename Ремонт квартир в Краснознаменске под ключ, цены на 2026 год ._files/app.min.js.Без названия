$(document).ready(function () {
    var accountBlock = $('.account');
    var accountCityItem = accountBlock.find('.city-item');
    var accountRelatedCompanies = accountBlock.find('.city-related-company');
    var accountDropdown = accountBlock.find('.dropdown-toggle');

    accountCityItem.on('click', function () {
        if ($(this).hasClass('active')) {
            return false;
        }

        var targetCompany = $(this).data('target');
        targetCompany = $(targetCompany);

        accountCityItem.removeClass('active');
        $(this).addClass('active');

        if (targetCompany.length && accountRelatedCompanies.length) {
            accountRelatedCompanies.removeClass('active');
            targetCompany.addClass('active');
        }
    });

    accountDropdown.on('click', function (e) {
        e.preventDefault();
        var accountDropdownMenu = $(this).next('.dropdown-menu');
        if (accountDropdownMenu.length) {
            if ($(this).hasClass('active')) {
                $(this).removeClass('active');
            } else {
                accountDropdown.removeClass('active');
                $(this).addClass('active');
            }
        }
    });

    const cookieObj = new URLSearchParams(document.cookie.replaceAll("&", "%26").replaceAll("; ","&"))
    if (!cookieObj.get("cookie-acceptance")) {
        $('#cookie').addClass('active');
    }

    $('#cookie-acceptance').on('click', function (e) {
        e.preventDefault();
        $('#cookie').remove();

        let expiryDate=new Date();
        expiryDate.setMonth(expiryDate.getMonth() + 1);
        document.cookie = 'cookie-acceptance=1;domain=' + location.hostname + ';path=/;expires=' + expiryDate.toGMTString();
    });

    $('.burger-button').click(function() {
        $('.burger-container').toggleClass('active');
        $('body').toggleClass('locked');
    });

    $('.spoiler-name').click(function() {
        var spoiler = $(this).closest('.spoiler');
        spoiler.toggleClass('active');
        spoiler.find('.spoiler-body').slideToggle(300);
    });
});